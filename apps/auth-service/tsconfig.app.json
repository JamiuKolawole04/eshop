    },
    {
      "path": "../../packages/cookies/tsconfig.lib.json"
    },
    {
      "path": "../../packages/error-handler/tsconfig.lib.json"
    },
    {
      "path": "../../packages/prisma/tsconfig.lib.json"
    },
    {
      "path": "../../packages/logs/tsconfig.lib.json"
    },
    {
      "path": "../../packages/redis/tsconfig.lib.json"
    }
  ],
