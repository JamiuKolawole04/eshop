{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "../../",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
  },
  "include": [
    "src/**/*",
    "src/**/*.ts",
    "../../packages/types/src/express.d.ts",
    "src/**/*.json",
